<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="566.0" prefWidth="880.0" stylesheets="@styleHome.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.bugboard26frontend.ExternalUserHomeController">
    <!-- BARRA LATERALE: Solo le 2 opzioni per l'External User -->
    <left>
        <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="250.0" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <Label alignment="CENTER" prefHeight="58.0" prefWidth="261.0" text="BugBoard" textFill="WHITE">
                    <padding>
                        <Insets top="40.0" />
                    </padding>
                    <font>
                        <Font name="Segoe UI Bold" size="28.0" />
                    </font>
                </Label>

                <!-- 1. Visualizzazione elenco Bug -->
                <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onElencoBugButtonClick" prefHeight="45.0" prefWidth="114.0" styleClass="nav-button" text="Elenco Bug" />

                <!-- Separatore per posizionare il logout sul fondo -->
                <Region VBox.vgrow="ALWAYS" />

                <!-- 2. Logout -->
                <Button fx:id="logoutButton" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onLogoutButtonClick" prefHeight="45.0" prefWidth="114.0" styleClass="nav-button" text="Logout">
                    <VBox.margin>
                        <Insets bottom="25.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>

    <!-- AREA CENTRALE: Tabella con attributi specifici per Bug -->
    <center>
        <StackPane fx:id="contentArea" prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <children>
                <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0">
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                    </padding>
                    <children>
                        <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="Elenco Bug" textFill="WHITE">
                            <font>
                                <Font name="Segoe UI Bold" size="28.0" />
                            </font>
                        </Label>

                        <!-- Tabella con attributi dedicati al Bug -->
                        <TableView fx:id="bugTable" prefHeight="322.0" prefWidth="569.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" maxWidth="50.0" minWidth="50.0" prefWidth="50.0" text="ID" />
                                <TableColumn fx:id="colTitolo" maxWidth="160.0" minWidth="150.0" prefWidth="160.0" text="Titolo" />
                                <TableColumn fx:id="colSeverita" maxWidth="90.0" minWidth="80.0" prefWidth="85.0" text="Severità" />
                                <TableColumn fx:id="colStato" maxWidth="80.0" minWidth="80.0" text="Stato" />
                                <TableColumn fx:id="colComponente" maxWidth="110.0" minWidth="95.0" prefWidth="105.0" text="Componente" />
                                <TableColumn fx:id="colVersione" maxWidth="90.0" minWidth="75.0" prefWidth="80.0" text="Versione" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <!-- Dettaglio esteso: per i bug include descrizione e passi di riproduzione -->
                        <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0">
                            <children>
                                <Label text="Dettagli e Passi per Riprodurre" textFill="#a29bb8" />
                                <TextArea fx:id="descriptionArea" editable="false" prefHeight="200.0" prefWidth="569.0" promptText="Seleziona un bug dall'elenco per visualizzarne la descrizione e i passi per riprodurlo..." styleClass="text-area" wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>