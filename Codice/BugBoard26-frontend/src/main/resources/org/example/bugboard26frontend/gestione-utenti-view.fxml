<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER" prefHeight="680.0" spacing="30.0" style="-fx-background-color: #0b0914;" stylesheets="@styleHome.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.bugboard26frontend.GestioneUtentiController">

    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <!-- COLONNA SINISTRA: Elenco Issue Attive -->
    <VBox fx:id="colonnaDashboard" managed="false" spacing="15.0" visible="false" HBox.hgrow="ALWAYS">
        <HBox prefHeight="33.0" prefWidth="592.0" spacing="5.0">
            <children>
                <Label prefHeight="28.0" prefWidth="152.0" text="Issue Attive" textFill="WHITE">
                    <font>
                        <Font name="Segoe UI Bold" size="22.0" />
                    </font>
                </Label>
                <Region prefHeight="200.0" prefWidth="200.0" />
            </children>
        </HBox>




        <!-- Text area spostata sotto la tabella di sinistra -->
        <Label text="Descrizione Issue Selezionata" textFill="#a29bb8" />
        <TextArea fx:id="descriptionArea" editable="false" prefHeight="119.0" prefWidth="592.0" styleClass="dark-text-area" wrapText="true" />
        <HBox prefHeight="65.0" prefWidth="592.0" spacing="20.0">
            <children>
                <Button fx:id="archiviaIssueButton" disable="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="66.0" prefWidth="380.0" styleClass="attachment-button" stylesheets="@style.css" text="Archivia Issue" />
                <Button fx:id="segnalaComeDuplicatoButton" disable="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="66.0" prefWidth="380.0" styleClass="attachment-button" stylesheets="@style.css" text="Segnala come duplicato" />
                <Button fx:id="visualizzaAllegatoButton" disable="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="66.0" prefWidth="380.0" styleClass="attachment-button" stylesheets="@style.css" text="Visualizza allegato" />
            </children>
        </HBox>
    </VBox>





    <!-- COLONNA CENTRALE: Pannello di Controllo (Stile Pop-up) -->
    <VBox alignment="CENTER" maxWidth="350.0" minWidth="350.0" spacing="40.0" styleClass="vbox" stylesheets="@style.css">
        <padding>
            <Insets bottom="50.0" left="30.0" right="30.0" top="50.0" />
        </padding>

        <!-- Titolo Neon -->
        <Label styleClass="title-bugboard" text="BugBoard" />

        <VBox alignment="CENTER" spacing="20.0" stylesheets="@style.css">

            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onGestioneUtentiButtonClick" prefHeight="50.0" prefWidth="250.0" styleClass="button-image" text="Gestione Utenti" />

            <Button fx:id="indietroButton" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onIndietroButtonClick" prefHeight="50.0" prefWidth="250.0" styleClass="button-image" text="⬅ Indietro" />

        </VBox>
    </VBox>













    <!-- COLONNA DESTRA: Gestione Utenti -->
    <VBox fx:id="colonnaGestione" managed="true" spacing="15.0" visible="true" HBox.hgrow="ALWAYS">
      <HBox prefHeight="33.0" prefWidth="592.0" spacing="5.0">
         <children>
              <Label prefHeight="28.0" prefWidth="67.0" text="Utenti" textFill="WHITE">
                  <font>
                      <Font name="Segoe UI Bold" size="22.0" />
                  </font>
              </Label>
            <Region HBox.hgrow="ALWAYS" />
            <ChoiceBox fx:id="filtroChoiceBox" prefWidth="150.0" />
         </children>
      </HBox>
        <TableView fx:id="utentiTable" styleClass="dark-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="emailColumn" prefWidth="300.0" text="Email" />
                <TableColumn fx:id="ruoloColumn" prefWidth="130.0" text="Ruolo" />
                <TableColumn fx:id="statoAccountColumn" prefWidth="60.0" text="Stato" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox prefHeight="65.0" prefWidth="592.0" spacing="20.0">
            <children>
                <Button fx:id="creaUtenteButton" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onCreaUtenteButtonClick" prefHeight="66.0" prefWidth="380.0" styleClass="attachment-button" stylesheets="@style.css" text="Crea Utente" HBox.hgrow="ALWAYS" />
                <Button fx:id="cambiaStatoButton" disable="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onCambiaStatoButtonClick" prefHeight="66.0" prefWidth="380.0" styleClass="attachment-button" stylesheets="@style.css" text="Disattiva Utente" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
    </VBox>

</HBox>
