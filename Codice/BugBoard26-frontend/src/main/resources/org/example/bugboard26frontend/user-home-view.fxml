<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<HBox alignment="CENTER" prefHeight="680.0" spacing="30.0" style="-fx-background-color: #0b0914;" stylesheets="@styleHome.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.bugboard26frontend.controller.UserHomeController">

    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <VBox fx:id="colonnaSinistra" managed="false" spacing="15.0" visible="false" HBox.hgrow="ALWAYS">
      <HBox prefHeight="33.0" prefWidth="592.0" spacing="5.0">
          <Label prefHeight="28.0" prefWidth="152.0" text="Issue Attive" textFill="WHITE">
              <font>
                  <Font name="Segoe UI Bold" size="22.0" />
              </font>
          </Label>
        <Region prefHeight="200.0" prefWidth="200.0" />
        <ChoiceBox fx:id="filtroChoiceBox" prefWidth="150.0" />
        <ChoiceBox fx:id="ordinaChoiceBox" prefWidth="150.0" />
      </HBox>

        <TableView fx:id="issueTable" prefHeight="321.0" prefWidth="650.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn maxWidth="50.0" minWidth="50.0" text="ID" />
                <TableColumn minWidth="150.0" text="Titolo" />
                <TableColumn minWidth="80.0" text="Priorità" />
                <TableColumn minWidth="100.0" text="Stato" />
                <TableColumn minWidth="140.0" text="Tipo" />
                <TableColumn minWidth="140.0" text="Data" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>


        <Label text="Descrizione Issue Selezionata" textFill="#a29bb8" />
        <TextArea fx:id="descriptionArea" editable="false" prefHeight="119.0" prefWidth="592.0" wrapText="true" />

        <HBox prefHeight="65.0" prefWidth="592.0" spacing="10.0">
            <Button fx:id="prendiInCaricoButton" disable="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#prendiInCaricoButtonClick" prefHeight="66.0" prefWidth="380.0" styleClass="attachment-button" stylesheets="@style.css" text="Prendi in carico" HBox.hgrow="ALWAYS" />

            <Button fx:id="rilasciaIssueButton" disable="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#rilasciaIssueButtonClick" prefHeight="66.0" prefWidth="380.0" styleClass="attachment-button" stylesheets="@style.css" text="Rilascia Issue" HBox.hgrow="ALWAYS" />

            <Button fx:id="visualizzaAllegatoButton" disable="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onVisualizzaAllegatoButtonClick" prefHeight="66.0" prefWidth="380.0" styleClass="attachment-button" stylesheets="@style.css" text="Visualizza allegato" HBox.hgrow="ALWAYS" />
        </HBox>
    </VBox>





    <!-- COLONNA CENTRALE: Pannello di Controllo (Stile Pop-up) -->
    <VBox alignment="CENTER" maxWidth="350.0" minWidth="350.0" spacing="40.0" styleClass="vbox" stylesheets="@style.css">
        <padding>
            <Insets bottom="50.0" left="30.0" right="30.0" top="50.0" />
        </padding>

        <Label styleClass="title-bugboard" text="BugBoard" />

        <VBox alignment="CENTER" spacing="20.0" stylesheets="@style.css">
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onElencoIssueButtonClick" prefHeight="50.0" prefWidth="250.0" styleClass="button-image" text="Elenco Issue" />

            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onSegnalaIssueButtonClick" prefHeight="50.0" prefWidth="250.0" styleClass="button-image" text="Segnala Issue" />
            <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onBugArchiviatiButtonClick" prefHeight="50.0" prefWidth="250.0" styleClass="button-image" text="Archivio Issue" />

            <MenuButton maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="6.0" prefWidth="266.0" text="Impostazioni">
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#onCambioPasswordButtonClick" text="Cambio Password" />
                    <MenuItem fx:id="logoutButton" mnemonicParsing="false" onAction="#onLogoutButtonClick" text="Logout" />
                </items>
            </MenuButton>
        </VBox>
    </VBox>









    <VBox fx:id="colonnaDestra" managed="false" spacing="15.0" visible="false" HBox.hgrow="ALWAYS">
        <Label text="Bug Archiviati" textFill="#a29bb8">
            <font>
                <Font name="Segoe UI Bold" size="22.0" />
            </font>
        </Label>
        <TableView fx:id="archiviatiTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn minWidth="50.0" maxWidth="50.0" text="ID" />
                <TableColumn minWidth="150.0" text="Titolo" />
                <TableColumn minWidth="80.0" text="Priorità" />
                <TableColumn minWidth="130.0" text="Tipo" />
                <TableColumn minWidth="110.0" text="Stato" />
                <TableColumn minWidth="140.0" text="Data Risoluzione" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

</HBox>
