<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="680.0" prefWidth="800.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.bugboard26frontend.CreazioneUtenteController">
    <children>
        <VBox alignment="CENTER" layoutX="225.0" layoutY="75.0" prefHeight="450.0" prefWidth="350.0" spacing="20.0" styleClass="vbox" stylesheets="@style.css" AnchorPane.bottomAnchor="75.0" AnchorPane.leftAnchor="180.0" AnchorPane.rightAnchor="180.0" AnchorPane.topAnchor="75.0">
            <children>
                <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="58.0" prefWidth="286.0" styleClass="title-bugboard" text="Nuovo Utente" textAlignment="CENTER">
                    <font>
                        <Font name="Segoe UI Bold" size="36.0" />
                    </font>
                </Label>

                <!-- Etichetta di Avvertenza -->
                <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="⚠️ ATTENZIONE: Controlla bene il Ruolo prima di confermare." textFill="#ff6b6b" wrapText="true">
                    <font>
                        <Font name="Segoe UI Bold" size="14.0" />
                    </font>
                </Label>

                <TextField fx:id="emailField" promptText="Email" />
                <PasswordField fx:id="passwordField" promptText="Password temporanea" />

                <!-- Menu a tendina per il Ruolo (stile Issue) -->
                <MenuButton fx:id="ruoloMenuButton" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Seleziona Ruolo">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#onExternalUserSelezionato" text="EXTERNAL_USER (Cliente)" />
                        <MenuItem mnemonicParsing="false" onAction="#onInternalUserSelezionato" text="INTERNAL_USER (Dipendente)" />
                        <MenuItem mnemonicParsing="false" onAction="#onAdminSelezionato" text="ADMIN (Amministratore)" />
                    </items>
                </MenuButton>

                <Button fx:id="confermaButton" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onConfermaButtonClick" prefHeight="28.0" prefWidth="124.0" text="Crea Utente">
                    <font>
                        <Font name="Segoe UI" size="14.0" />
                    </font>
                </Button>

                <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onAnnullaButtonClick" styleClass="button-image" text="Annulla" />

            </children>
        </VBox>
    </children>
</AnchorPane>