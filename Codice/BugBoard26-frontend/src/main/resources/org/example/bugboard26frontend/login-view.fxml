<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" prefHeight="300.0" prefWidth="400.0" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.bugboard26frontend.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Benvenuto">
         <font>
            <Font name="Comic Sans MS Bold" size="36.0" />
         </font>
      </Text>
      <TextField fx:id="emailField" />
      <PasswordField fx:id="passwordField" />
      <Button mnemonicParsing="false" onAction="#onLoginButtonClick" text="Conferma">
         <font>
            <Font name="Comic Sans MS Bold Italic" size="12.0" />
         </font></Button>
   </children>
</VBox>
